# Dépendances et build du front : se régénèrent avec npm install et npm run build
front/node_modules/
front/dist/

# Images téléversées par l'administration : des données, pas du code
uploads/*
!uploads/.gitkeep

# Fichiers de session de PHP : des données de visiteurs, pas du code
back/sessions/*
!back/sessions/.gitkeep
!back/sessions/.htaccess

# Fichiers d'environnement des éditeurs et systèmes
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
